#!/usr/bin/perl
use strict;
use warnings;
no warnings 'redefine';
no warnings 'uninitialized';
require "gray-theme/gray-theme-lib.pl";
require "gray-theme/theme.pl";
&ReadParse();
&load_theme_library();

&popup_header("MemoNetwork Dashboard v4.4");
print <<'HTML';
<style>
:root{--bg:#08111c;--panel:#111d2c;--panel2:#16253a;--panel3:#0d1826;--border:#283d58;--text:#f7f9ff;--muted:#8ea4bd;--blue:#38bdf8;--blue2:#2563eb;--purple:#a78bfa;--green:#34d399;--orange:#f59e0b;--red:#ef4444;--yellow:#facc15}
*{box-sizing:border-box}html,body{background:var(--bg)!important;color:var(--text)!important}.v3{max-width:1640px;margin:auto;padding:16px 20px 28px}.topbar,.card,.detail,.system-strip,.disks,.admin,.controlbar,.health-panel,.incident-panel{border:1px solid var(--border);background:linear-gradient(145deg,var(--panel2),var(--panel));border-radius:14px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:12px 16px;margin-bottom:10px;box-shadow:0 8px 28px rgba(0,0,0,.18)}.brandline{display:flex;align-items:center;gap:11px;min-width:0}.brandline h1{margin:0;color:#fff!important;font-size:21px;line-height:1.1}.brandline .ver{color:#7dc4ff;font-size:11px;font-weight:800;border:1px solid #315d8a;background:#0e2038;padding:5px 8px;border-radius:999px}.topmeta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}.pill{border:1px solid #304965;background:#0e1b2b;color:#9db7d3;padding:7px 10px;border-radius:999px;font-size:10px;font-weight:700}.pill.live{color:#86efac;border-color:#1f6849}.pill.live:before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:#22c55e;box-shadow:0 0 8px #22c55e;margin-right:6px}.pill.error{color:#fca5a5;border-color:#7f1d1d}.pill.warn{color:#fde68a;border-color:#92400e}.controlbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;margin-bottom:10px}.quick-actions{display:flex;gap:7px;flex-wrap:wrap}.quick-btn{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border:1px solid #31506f;border-radius:8px;background:#0d1a2a;color:#b9d7f5!important;text-decoration:none!important;font:700 11px/16px Inter,Arial,sans-serif;cursor:pointer}.quick-btn:hover{border-color:#3b82f6;background:#12243b}.quick-btn.primary{background:#12315a;border-color:#2f6aa5;color:#dbeafe!important}.refresh-tools{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:10px}.refresh-tools select{background:#0b1726;color:#dbeafe;border:1px solid #304965;border-radius:7px;padding:6px 8px;font-size:10px}.alerts{display:grid;gap:8px;margin-bottom:10px}.alert{display:none;align-items:center;justify-content:space-between;gap:18px;padding:12px 15px;border-radius:12px;border:1px solid}.alert.show{display:flex}.alert strong{display:block;font-size:13px}.alert span{display:block;margin-top:3px;font-size:11px}.alert-updates{border-color:#315d8a;background:#10213a;color:#dbeafe}.alert-reboot{border-color:#a86100;background:linear-gradient(90deg,#2b1b08,#17191f);color:#ffd28a}.alert-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.alert a,.alert button{padding:8px 12px;border-radius:8px;border:1px solid transparent;font:700 11px/17px Inter,Arial,sans-serif!important;color:#fff!important;text-decoration:none!important;cursor:pointer}.alert a{background:#2563eb!important;border-color:#3b82f6!important}.alert-reboot a{background:#ea580c!important;border-color:#fb923c!important}.alert-reboot .reboot-now{background:#dc2626!important;border-color:#f87171!important}.alert-reboot .reboot-now:disabled{opacity:.6;cursor:wait}.grid4,.grid2,.services,.system-grid,.disk-grid,.admin-grid,.health-grid{display:grid;gap:12px}.grid4,.services{grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:12px}.grid2{grid-template-columns:2fr 1fr;margin-bottom:12px}.card{position:relative;min-height:116px;padding:15px;overflow:hidden;transition:border-color .2s,transform .2s,box-shadow .2s}.card.click-card{cursor:pointer}.card.click-card:hover,.service.clickable:hover{transform:translateY(-1px);border-color:#3b82f6}.card.warn{border-color:#a16207;box-shadow:inset 0 0 0 1px rgba(250,204,21,.08)}.card.danger{border-color:#991b1b;box-shadow:inset 0 0 0 1px rgba(239,68,68,.12)}.label{display:flex;align-items:center;justify-content:space-between;color:#b9c9dc;font-weight:800;font-size:11px;text-transform:uppercase;letter-spacing:.07em}.value{display:block;margin-top:11px;font-size:27px;font-weight:800;color:#fff}.sub{display:block;color:var(--muted);font-size:11px;margin-top:4px}.meter{position:absolute;left:15px;right:15px;bottom:13px;height:5px;background:#08111d;border-radius:999px;overflow:hidden}.meter i{display:block;height:100%;width:0;border-radius:999px;transition:width .35s}.cpu i{background:linear-gradient(90deg,#38bdf8,#3b82f6)}.ram i{background:linear-gradient(90deg,#8b5cf6,#c084fc)}.storage i{background:linear-gradient(90deg,#22c55e,#2dd4bf)}.live-small{color:#86efac;font-size:10px}.live-small:before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:#22c55e;box-shadow:0 0 7px #22c55e;margin-right:5px}.traffic{display:grid;grid-template-columns:1fr 1fr;margin-top:11px}.traffic strong{font-size:21px}.chart{position:absolute;left:15px;right:15px;bottom:9px;height:38px}.chart svg{width:100%;height:100%}.line{fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.rx{stroke:var(--blue)}.tx{stroke:var(--purple)}.load{stroke:var(--orange)}.section-title{display:flex;align-items:center;justify-content:space-between;margin:17px 2px 8px}.section-title h2{margin:0;color:#e9f2ff!important;font-size:16px}.section-title span{font-size:10px;color:var(--muted)}.health-panel{padding:12px 14px;margin-bottom:12px}.health-grid{grid-template-columns:1.1fr repeat(4,minmax(0,1fr));align-items:center}.health-main{display:flex;align-items:center;gap:11px}.health-ring{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#22c55e 0deg,#22c55e 360deg,#172337 360deg);position:relative}.health-ring:after{content:"";position:absolute;inset:5px;border-radius:50%;background:#0d1826}.health-ring strong{position:relative;z-index:1;font-size:12px}.health-copy strong{display:block;font-size:13px}.health-copy span{display:block;margin-top:3px;color:var(--muted);font-size:10px}.health-item small{display:block;color:#7890aa;font-size:9px;text-transform:uppercase;font-weight:800}.health-item strong{display:block;margin-top:5px;font-size:12px}.incident-panel{display:none;padding:12px 14px;margin-bottom:12px}.incident-panel.show{display:block}.incident-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:8px}.incident-head strong{font-size:13px}.incident-count{font-size:10px;color:#fde68a;border:1px solid #7c5b17;background:#2a210d;border-radius:999px;padding:4px 8px}.incident-list{display:grid;gap:7px}.incident{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 10px;border:1px solid #33435a;background:#0d1826;border-radius:9px}.incident.warning{border-color:#7c5b17}.incident.critical{border-color:#7f1d1d;background:#211113}.incident-copy strong{font-size:11px}.incident-copy span{display:block;margin-top:3px;color:#9fb0c4;font-size:10px}.incident a{color:#8fd3ff!important;text-decoration:none!important;font-size:10px;font-weight:700;white-space:nowrap}.system-strip{padding:13px;margin-bottom:12px}.system-grid{grid-template-columns:repeat(6,minmax(0,1fr))}.sys{min-width:0}.sys small{display:block;color:#7890aa;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.sys strong{display:block;margin-top:6px;color:#eef6ff;font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.service{min-height:110px}.service.clickable{cursor:pointer}.service.clickable:after{content:'Details';position:absolute;right:14px;bottom:11px;color:#7dc4ff;font-size:10px}.service-title{font-size:14px;font-weight:800}.status{display:flex;align-items:center;gap:8px;margin-top:13px}.dot{width:8px;height:8px;border-radius:50%;background:#64748b}.dot.ok{background:#22c55e;box-shadow:0 0 9px rgba(34,197,94,.7)}.dot.off{background:var(--red)}.count{margin-top:9px;color:var(--muted);font-size:11px}.count strong{color:#fff;font-size:18px}.detail{display:none;padding:16px;margin:0 0 12px}.detail.show{display:block}.detail-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.detail-head h3{margin:0;font-size:17px}.detail-close{border:1px solid #3a4d68;background:#172337;color:#fff;border-radius:8px;padding:7px 10px;cursor:pointer}.detail-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:12px}.detail-box{padding:12px;background:#0d1826;border:1px solid #263a54;border-radius:10px}.detail-box small{display:block;color:var(--muted);font-size:9px;text-transform:uppercase}.detail-box strong{display:block;margin-top:6px;font-size:15px}.service-list{margin-top:12px;border:1px solid #263a54;border-radius:10px;overflow:hidden;background:#0d1826}.service-row{display:grid;grid-template-columns:minmax(150px,1.1fr) minmax(210px,2fr) minmax(120px,.9fr) minmax(145px,.9fr);gap:12px;align-items:center;padding:10px 12px;border-top:1px solid #203249}.service-row:first-child{border-top:0}.service-head{background:#122238;color:#8fa5bf;font-size:9px;font-weight:800;text-transform:uppercase}.service-name{font-weight:800;color:#fff;font-size:11px}.service-meta{color:#9db1ca;font-size:10px;overflow-wrap:anywhere}.state{display:inline-flex;align-items:center;gap:6px;font-size:10px;font-weight:700}.state:before{content:'';width:7px;height:7px;border-radius:50%;background:#ef4444}.state.ok{color:#86efac}.state.ok:before{background:#22c55e}.service-controls{display:flex;gap:5px;justify-content:flex-end;flex-wrap:wrap}.svc-btn{border:1px solid #315d8a;background:#10233b;color:#dbeafe;border-radius:7px;padding:6px 8px;font:700 10px Arial,sans-serif;cursor:pointer}.svc-btn:hover{background:#17345a}.svc-btn.restart{border-color:#6d4cc8;background:#241547;color:#ddd6fe}.svc-btn.stop{border-color:#b45309;background:#4a2108;color:#fed7aa}.svc-btn.start{border-color:#166534;background:#0e3820;color:#bbf7d0}.svc-btn:disabled{opacity:.55;cursor:wait}.detail-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.detail-actions a{padding:8px 11px;border-radius:8px;background:#162a46;border:1px solid #315d8a;color:#9bd0ff!important;text-decoration:none!important;font-size:11px}.action-result{display:none;margin-top:10px;padding:9px 11px;border-radius:8px;border:1px solid #315d8a;background:#0d1c2d;color:#bfdbfe;font-size:10px}.action-result.show{display:block}.action-result.error{border-color:#7f1d1d;background:#241013;color:#fecaca}.disks{padding:14px;margin-bottom:12px}.disk-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.disk{padding:12px;background:#0d1826;border:1px solid #263a54;border-radius:10px}.disk-top{display:flex;justify-content:space-between;gap:10px}.disk-path{font-weight:800;font-size:12px}.disk-meta{color:var(--muted);font-size:10px}.disk-device{margin-top:5px;color:#7890aa;font-size:9px}.disk-bar{height:6px;background:#07101b;border-radius:999px;overflow:hidden;margin-top:10px}.disk-bar i{display:block;height:100%;background:linear-gradient(90deg,#22c55e,#2dd4bf);border-radius:999px}.disk.high .disk-bar i{background:linear-gradient(90deg,#f59e0b,#f97316)}.disk.critical .disk-bar i{background:linear-gradient(90deg,#ef4444,#dc2626)}.admin{padding:14px}.admin summary{cursor:pointer;font-size:15px;font-weight:800;list-style:none;color:#fff!important}.admin summary:after{content:'＋';float:right;color:#7dc4ff}.admin[open] summary:after{content:'−'}.admin-grid{grid-template-columns:repeat(4,minmax(0,1fr));margin-top:14px}.admin-link{display:block;padding:13px;border:1px solid var(--border);border-radius:11px;background:#0d1826;color:#fff!important;text-decoration:none!important}.admin-link strong{display:block;font-size:12px}.admin-link span{display:block;margin-top:4px;color:var(--muted);font-size:10px}.admin-link:hover{border-color:#3b82f6;background:#132239}
@media(max-width:1200px){.health-grid{grid-template-columns:repeat(3,1fr)}.system-grid{grid-template-columns:repeat(3,1fr)}.admin-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:980px){.grid4,.services{grid-template-columns:repeat(2,1fr)}.grid2{grid-template-columns:1fr}.disk-grid{grid-template-columns:1fr}.controlbar{align-items:flex-start;flex-direction:column}.service-row{grid-template-columns:1fr 1.5fr .8fr}.service-controls{grid-column:1/-1;justify-content:flex-start}}@media(max-width:650px){.v3{padding:10px}.topbar{align-items:flex-start;flex-direction:column}.brandline h1{font-size:19px}.topmeta{justify-content:flex-start}.grid4,.services,.system-grid,.admin-grid,.detail-summary,.health-grid{grid-template-columns:1fr}.service-row{grid-template-columns:1fr;gap:4px}.service-head{display:none}.incident{align-items:flex-start;flex-direction:column}.alert.show{align-items:flex-start;flex-direction:column}}
</style>
<div class="v3">
  <header class="topbar"><div class="brandline"><h1>MemoNetwork</h1><span class="ver">Dashboard v4.4</span></div><div class="topmeta"><span class="pill live" id="api-pill">LIVE</span><span class="pill" id="health-pill">Status laden…</span><span class="pill" id="host-pill">Server</span><span class="pill">Webmin 2.653</span></div></header>

  <div class="controlbar"><div class="quick-actions"><button class="quick-btn primary" id="refresh-now" type="button">↻ Nu verversen</button><a class="quick-btn" href="/memo-network/system-info.cgi">Systeeminfo</a><a class="quick-btn" href="/package-updates/index.cgi">Updates</a><a class="quick-btn" href="https://amp.memocraft.nl" target="_blank" rel="noopener">AMP openen</a><a class="quick-btn" href="/mount/index.cgi">Schijven</a><a class="quick-btn" href="/init/index.cgi">Herstartbeheer</a></div><div class="refresh-tools"><span id="refresh-label">Automatisch: 3 sec</span><select id="refresh-select"><option value="3000">3 sec</option><option value="5000">5 sec</option><option value="10000">10 sec</option><option value="30000">30 sec</option><option value="0">Pauze</option></select></div></div>

  <div class="alerts"><div class="alert alert-updates" id="updates-alert"><div><strong id="updates-title">Updates beschikbaar</strong><span>Beschikbare systeem- en beveiligingsupdates kunnen worden geïnstalleerd.</span></div><a href="/package-updates/index.cgi">Updates openen</a></div><div class="alert alert-reboot" id="reboot-alert"><div><strong>Herstart vereist</strong><span id="reboot-message">Herstart de server om alle wijzigingen volledig toe te passen.</span></div><div class="alert-actions"><button class="reboot-now" id="reboot-now" type="button">Nu herstarten</button><a href="/init/index.cgi">Herstartbeheer</a></div></div></div>

  <section class="health-panel"><div class="health-grid"><div class="health-main"><div class="health-ring" id="health-ring"><strong id="health-score">--</strong></div><div class="health-copy"><strong id="health-title">Systeemstatus laden…</strong><span id="health-copy">Live controle van server en services</span></div></div><div class="health-item"><small>Services online</small><strong id="health-services">--</strong></div><div class="health-item"><small>Hoogste belasting</small><strong id="health-resource">--</strong></div><div class="health-item"><small>Actieve meldingen</small><strong id="health-alerts">--</strong></div><div class="health-item"><small>API reactietijd</small><strong id="health-latency">--</strong></div></div></section>

  <section class="incident-panel" id="incident-panel"><div class="incident-head"><strong>Meldingen</strong><span class="incident-count" id="incident-count">0 actief</span></div><div class="incident-list" id="incident-list"></div></section>

  <div class="grid4"><div class="card cpu click-card" id="cpu-card" data-open="/memo-network/processes.cgi"><div class="label">CPU <span class="live-small">Live</span></div><strong class="value" id="cpu">--</strong><span class="sub" id="cpu-sub">Actuele belasting</span><div class="meter"><i id="cpu-bar"></i></div></div><div class="card ram click-card" id="ram-card" data-open="/memo-network/system-info.cgi"><div class="label">Geheugen <span class="live-small">Live</span></div><strong class="value" id="ram">--</strong><span class="sub" id="ram-total">Totaal geheugen</span><div class="meter"><i id="ram-bar"></i></div></div><div class="card storage click-card" id="storage-card" data-open="/mount/index.cgi"><div class="label">Opslag <span class="live-small">Live</span></div><strong class="value" id="storage-used">--</strong><span class="sub" id="storage-sub">Opslag laden…</span><div class="meter"><i id="storage-bar"></i></div></div><div class="card click-card" data-open="/memo-network/system-info.cgi"><div class="label">Uptime</div><strong class="value" id="uptime">--</strong><span class="sub">Server online</span></div></div>

  <div class="grid2"><div class="card"><div class="label">Netwerkverkeer <span class="live-small">Live</span></div><div class="traffic"><div><span class="sub">Download</span><strong id="rx">--</strong></div><div><span class="sub">Upload</span><strong id="tx">--</strong></div></div><div class="chart" id="network-chart"></div></div><div class="card" id="load-card"><div class="label">Load average <span>1 / 5 / 15 min</span></div><strong class="value" id="load1">--</strong><span class="sub"><span id="load5">5 min: --</span> &nbsp; <span id="load15">15 min: --</span></span><div class="chart" id="load-chart"></div></div></div>

  <div class="system-strip"><div class="system-grid"><div class="sys"><small>Besturingssysteem</small><strong id="sys-os">--</strong></div><div class="sys"><small>Kernel</small><strong id="sys-kernel">--</strong></div><div class="sys"><small>Processor</small><strong id="sys-cpu">--</strong></div><div class="sys"><small>Temperatuur</small><strong id="sys-temp">--</strong></div><div class="sys"><small>Processen</small><strong id="sys-processes">--</strong></div><div class="sys"><small>Laatste update</small><strong id="last-update">--</strong></div></div></div>

  <div class="section-title"><h2>Services</h2><span>Klik op een service voor live details en beheer</span></div><div class="services"><div class="card service clickable" id="docker-card" data-service="docker"><div class="service-title">Docker</div><div class="status"><span class="dot" id="docker-dot"></span><span id="docker-status">Controleren…</span></div><div class="count"><strong id="docker-running">--</strong> actief van <strong id="docker-total">--</strong> containers</div></div><div class="card service clickable" id="amp-card" data-service="amp"><div class="service-title">AMP</div><div class="status"><span class="dot" id="amp-dot"></span><span id="amp-status">Controleren…</span></div><div class="count"><strong id="amp-running">--</strong> actief van <strong id="amp-total">--</strong> instances</div></div><div class="card service clickable" id="minio-card" data-service="minio"><div class="service-title">MinIO</div><div class="status"><span class="dot" id="minio-dot"></span><span id="minio-status">Controleren…</span></div><div class="count" id="minio-count">S3-opslagservice</div></div><div class="card service clickable" id="wireguard-card" data-service="wireguard"><div class="service-title">WireGuard</div><div class="status"><span class="dot" id="wireguard-dot"></span><span id="wireguard-status">Controleren…</span></div><div class="count" id="wireguard-count">VPN-interface wg0</div></div></div>

  <section class="detail" id="service-detail"><div class="detail-head"><h3 id="detail-title">Service-details</h3><button class="detail-close" id="detail-close" type="button">Sluiten</button></div><div class="detail-summary"><div class="detail-box"><small>Status</small><strong id="detail-status">--</strong></div><div class="detail-box"><small>Actief</small><strong id="detail-running">--</strong></div><div class="detail-box"><small>Totaal</small><strong id="detail-total">--</strong></div></div><div class="action-result" id="action-result"></div><div class="service-list" id="service-list"></div><div class="detail-actions" id="detail-actions"></div></section>

  <div class="section-title"><h2>Opslag</h2><span>Per gemount bestandssysteem</span></div><section class="disks"><div class="disk-grid" id="disk-grid"><div class="disk"><div class="disk-meta">Opslaggegevens laden…</div></div></div></section>

  <details class="admin"><summary>Systeembeheer en Webmin-functies</summary><div class="admin-grid"><a class="admin-link" href="/memo-network/system-info.cgi"><strong>Systeeminformatie</strong><span>Serverstatus bekijken</span></a><a class="admin-link" href="/mount/index.cgi"><strong>Schijven</strong><span>Mounts en vrije ruimte</span></a><a class="admin-link" href="/net/index.cgi"><strong>Netwerkinterfaces</strong><span>IP en netwerkconfiguratie</span></a><a class="admin-link" href="/memo-network/processes.cgi"><strong>Actieve processen</strong><span>Processen bekijken</span></a><a class="admin-link" href="/package-updates/index.cgi"><strong>Pakketupdates</strong><span>Updates installeren</span></a><a class="admin-link" href="/webminlog/search.cgi"><strong>Webmin-logboek</strong><span>Recente acties</span></a><a class="admin-link" href="/init/index.cgi"><strong>Opstarten en afsluiten</strong><span>Services en reboot</span></a><a class="admin-link" href="/edit_right.cgi"><strong>Dashboard configureren</strong><span>Klassieke onderdelen</span></a></div></details>
</div>
<script>
(()=>{
 const history={rx:[],tx:[],load:[]},limit=45;let latest=null,failures=0,timer=null,refreshMs=Number(localStorage.getItem('memoRefreshMs')||3000),openService='';
 const byId=id=>document.getElementById(id),num=v=>Number(v)||0,esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
 const push=(a,v)=>{a.push(Math.max(0,num(v)));if(a.length>limit)a.shift()};
 const rate=v=>{v=num(v);return v>=1024?(v/1024).toFixed(v>=10240?0:1)+' MiB/s':v.toFixed(v>=100?0:1)+' KiB/s'};
 const bytes=v=>{v=num(v);if(v>=1073741824)return(v/1073741824).toFixed(2)+' GiB';if(v>=1048576)return(v/1048576).toFixed(1)+' MiB';if(v>=1024)return(v/1024).toFixed(1)+' KiB';return Math.round(v)+' B'};
 const size=v=>{v=num(v);return v>=1024?(v/1024).toFixed(2)+' TiB':v.toFixed(v>=100?0:1)+' GiB'};
 const uptimeText=v=>{let s=Math.max(0,Math.floor(num(v))),d=Math.floor(s/86400);s%=86400;let h=Math.floor(s/3600);s%=3600;let m=Math.floor(s/60);return d?`${d} ${d===1?'dag':'dagen'}, ${h} uur, ${m} min`:h?`${h} uur, ${m} min`:`${m} min`};
 const ageText=v=>{if(v===null||v===undefined||v==='')return'Geen handshake';const s=Number(v);if(!Number.isFinite(s)||s<0)return'Geen handshake';if(s<60)return Math.floor(s)+' sec geleden';if(s<3600)return Math.floor(s/60)+' min geleden';if(s<86400)return Math.floor(s/3600)+' uur geleden';return Math.floor(s/86400)+' dagen geleden'};
 const shortKey=v=>{const s=String(v||'');return s.length>18?s.slice(0,9)+'…'+s.slice(-7):s};
 const path=(a,max)=>a.length?'M '+a.map((v,i)=>`${(a.length>1?i*100/(a.length-1):0).toFixed(2)} ${(40-Math.min(1,v/(max||1))*38).toFixed(2)}`).join(' L '):'';
 const chart=(id,sets)=>{const el=byId(id);if(el)el.innerHTML='<svg viewBox="0 0 100 40" preserveAspectRatio="none">'+sets.map(s=>`<path class="line ${s.cls}" d="${path(s.data,s.max)}"></path>`).join('')+'</svg>'};
 const service=(name,online)=>{byId(name+'-status').textContent=online?'Online':'Offline';byId(name+'-dot').classList.toggle('ok',!!online);byId(name+'-dot').classList.toggle('off',!online)};
 const severity=(el,pct,warn=75,danger=90)=>{el.classList.toggle('warn',pct>=warn&&pct<danger);el.classList.toggle('danger',pct>=danger)};
 function showAction(message,error=false){const el=byId('action-result');el.textContent=message;el.className='action-result show'+(error?' error':'');setTimeout(()=>{if(el.textContent===message)el.className='action-result'},4500)}
 function renderDisks(disks){const grid=byId('disk-grid');if(!disks.length){grid.innerHTML='<div class="disk"><div class="disk-meta">Geen schijfgegevens gevonden.</div></div>';return}grid.innerHTML=disks.map(d=>{const p=num(d.used_percent),cls=p>=90?'critical':p>=75?'high':'';return `<div class="disk ${cls}"><div class="disk-top"><span class="disk-path">${esc(d.path)}</span><span class="disk-meta">${p.toFixed(1)}% gebruikt</span></div><div class="disk-meta">${size(d.used_gib)} gebruikt · ${size(d.available_gib)} vrij · ${size(d.total_gib)} totaal</div><div class="disk-device">${esc(d.device||'Onbekend apparaat')} · ${esc(d.fstype||'bestandssysteem')}</div><div class="disk-bar"><i style="width:${Math.min(100,p)}%"></i></div></div>`}).join('')}
 function renderIncidents(alerts){const filtered=alerts.filter(a=>a.code!=='updates'&&a.code!=='reboot');const panel=byId('incident-panel'),list=byId('incident-list');byId('health-alerts').textContent=String(alerts.length);if(!filtered.length){panel.classList.remove('show');list.innerHTML='';return}panel.classList.add('show');byId('incident-count').textContent=filtered.length+' actief';list.innerHTML=filtered.map(a=>`<div class="incident ${esc(a.severity||'warning')}"><div class="incident-copy"><strong>${esc(a.title)}</strong><span>${esc(a.message)}</span></div>${a.link?`<a href="${esc(a.link)}"${/^https?:/.test(a.link)?' target="_blank" rel="noopener"':''}>${esc(a.link_label||'Bekijken')}</a>`:''}</div>`).join('')}
 function updateHealth({cpu,ramPct,diskPct,loadPct,services,latency,alerts}){const online=Object.values(services).filter(Boolean).length,total=Object.keys(services).length||1,offline=total-online,maxResource=Math.max(cpu,ramPct,diskPct,Math.min(100,loadPct));const critical=alerts.filter(a=>a.severity==='critical').length,warning=alerts.filter(a=>a.severity==='warning').length;let score=100;score-=Math.max(0,(maxResource-60)*.45);score-=offline*7;score-=critical*12;score-=warning*4;if(latency>1500)score-=8;else if(latency>800)score-=4;score=Math.max(0,Math.min(100,Math.round(score)));let state='Gezond',color='#22c55e';if(score<75){state='Aandacht nodig';color='#f59e0b'}if(score<45){state='Kritiek';color='#ef4444'}byId('health-score').textContent=score;byId('health-title').textContent=state;byId('health-copy').textContent=alerts.length?`${alerts.length} actieve melding${alerts.length===1?'':'en'}`:'Alle bewaakte onderdelen zijn in orde';byId('health-services').textContent=`${online} / ${total}`;byId('health-resource').textContent=Math.round(maxResource)+'%';byId('health-latency').textContent=latency+' ms';byId('health-ring').style.background=`conic-gradient(${color} 0deg,${color} ${score*3.6}deg,#172337 ${score*3.6}deg)`;const hp=byId('health-pill');hp.textContent=state;hp.className='pill '+(score<45?'error':score<75?'warn':'')}
 async function dockerAction(container,operation,button){if((operation==='stop'||operation==='restart')&&!confirm(`${container} ${operation==='stop'?'stoppen':'herstarten'}?`))return;const old=button.textContent;button.disabled=true;button.textContent='Bezig…';try{const url=`/memo-network/system-info.cgi?action=docker&operation=${encodeURIComponent(operation)}&container=${encodeURIComponent(container)}`;const r=await fetch(url,{method:'POST',credentials:'same-origin',cache:'no-store',headers:{'X-Requested-With':'MemoNetwork'}});const j=await r.json().catch(()=>({}));if(!r.ok||!j.ok)throw new Error(j.error||`HTTP ${r.status}`);showAction(`${container}: ${operation} uitgevoerd`);await new Promise(res=>setTimeout(res,600));await refresh();if(openService)renderServiceDetail(openService)}catch(e){showAction(`Docker-actie mislukt: ${e.message}`,true)}finally{button.disabled=false;button.textContent=old}}
 function controlButtons(name,running){return running?`<button class="svc-btn restart" data-docker="${esc(name)}" data-op="restart">Herstart</button><button class="svc-btn stop" data-docker="${esc(name)}" data-op="stop">Stop</button>`:`<button class="svc-btn start" data-docker="${esc(name)}" data-op="start">Start</button>`}
 function renderServiceDetail(type){if(!latest)return;openService=type;const s=latest.services||{},data=latest[type]||{},online=!!s[type],list=byId('service-list');byId('detail-title').textContent=type==='docker'?'Docker-beheer':type==='amp'?'AMP-instances':type==='minio'?'MinIO-beheer':'WireGuard-peers';byId('detail-status').textContent=online?'Online':'Offline';byId('detail-running').textContent=(type==='docker'||type==='amp')?num(data.running):type==='wireguard'?num(data.peers):(online?1:0);byId('detail-total').textContent=(type==='docker'||type==='amp')?num(data.total):type==='wireguard'?'peers':1;byId('action-result').className='action-result';byId('detail-actions').innerHTML=type==='amp'?'<a href="https://amp.memocraft.nl" target="_blank" rel="noopener">AMP openen</a><a href="/memo-network/processes.cgi">AMP-processen</a>':type==='docker'?'<a href="/memo-network/processes.cgi">Docker-processen</a>':type==='minio'?'<a href="/mount/index.cgi">Backup-opslag</a><a href="/memo-network/processes.cgi">MinIO-processen</a>':'<a href="/net/index.cgi">Netwerkinterfaces</a>';
 if(type==='docker'){const items=Array.isArray(data.items)?data.items:[];list.innerHTML=items.length?'<div class="service-row service-head"><span>Container</span><span>Image / netwerk</span><span>Status</span><span>Beheer</span></div>'+items.map(i=>`<div class="service-row"><span class="service-name">${esc(i.name)}<br><span class="service-meta">${esc(i.id||'')}</span></span><span class="service-meta"><strong>${esc(i.image||'Onbekend image')}</strong><br>${esc(i.ports||'Geen gepubliceerde poorten')}</span><span class="service-meta"><span class="state ${i.running?'ok':''}">${i.running?'Actief':'Gestopt'}</span><br>${esc(i.status||i.state||'')}</span><span class="service-controls">${controlButtons(i.name,!!i.running)}</span></div>`).join(''):'<div class="service-row"><span class="service-meta">Geen containers gevonden.</span></div>'}
 else if(type==='amp'){const items=Array.isArray(data.items)?data.items:[];list.innerHTML=items.length?'<div class="service-row service-head"><span>Instance</span><span>Module / poort</span><span>Status</span><span>Openen</span></div>'+items.map(i=>`<div class="service-row"><span class="service-name">${esc(i.name)}</span><span class="service-meta">${esc(i.module||'AMP instance')}${i.port?` · poort ${esc(i.port)}`:''}</span><span class="state ${i.running?'ok':''}">${i.running?'Actief':'Gestopt'}</span><span class="service-controls"><a class="quick-btn" href="https://amp.memocraft.nl" target="_blank" rel="noopener">AMP</a></span></div>`).join(''):'<div class="service-row"><span class="service-meta">Geen AMP-instances gevonden.</span></div>'}
 else if(type==='minio'){const name=data.container||'',isDocker=data.mode==='docker'&&name;list.innerHTML=`<div class="service-row"><span class="service-name">MinIO${data.container_id?`<br><span class="service-meta">${esc(data.container_id)}</span>`:''}</span><span class="service-meta">${data.mode==='docker'?`Docker-container ${esc(name)}`:data.mode==='process'?'Lokaal proces':'Niet gedetecteerd'}<br>${esc(data.ports||'')}</span><span class="service-meta"><span class="state ${online?'ok':''}">${online?'Online':'Offline'}</span><br>${esc(data.status||'')}</span><span class="service-controls">${isDocker?controlButtons(name,!!data.running):''}</span></div>`}
 else {const items=Array.isArray(data.items)?data.items:[];list.innerHTML=items.length?'<div class="service-row service-head"><span>Peer</span><span>Endpoint / IP</span><span>Verkeer / handshake</span><span>Status</span></div>'+items.map(i=>{const hasHandshake=i.handshake_age_seconds!==null&&i.handshake_age_seconds!==undefined;const age=hasHandshake?Number(i.handshake_age_seconds):Infinity,fresh=i.latest_handshake>0&&Number.isFinite(age)&&age<180;return `<div class="service-row"><span class="service-name" title="${esc(i.public_key)}">${esc(shortKey(i.public_key))}</span><span class="service-meta">${esc(i.endpoint||'Geen endpoint')}<br>${esc(i.allowed_ips||'Geen allowed IPs')}</span><span class="service-meta">RX ${bytes(i.rx_bytes)} · TX ${bytes(i.tx_bytes)}<br>${ageText(i.handshake_age_seconds)}</span><span class="state ${fresh?'ok':''}">${fresh?'Recent':'Inactief'}</span></div>`}).join(''):`<div class="service-row"><span class="service-name">${esc(data.interface||'wg0')}</span><span class="service-meta">Geen peers geconfigureerd of zichtbaar.</span><span class="state ${online?'ok':''}">${online?'Online':'Offline'}</span><span></span></div>`}
 list.querySelectorAll('[data-docker]').forEach(btn=>btn.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();dockerAction(btn.dataset.docker,btn.dataset.op,btn)}));byId('service-detail').classList.add('show');byId('service-detail').scrollIntoView({behavior:'smooth',block:'nearest'})}
 document.querySelectorAll('[data-service]').forEach(card=>card.addEventListener('click',()=>renderServiceDetail(card.dataset.service)));document.querySelectorAll('[data-open]').forEach(card=>card.addEventListener('click',()=>location.href=card.dataset.open));byId('detail-close').addEventListener('click',()=>{openService='';byId('service-detail').classList.remove('show')});
 byId('reboot-now').addEventListener('click',async()=>{if(!confirm('Server nu herstarten? Alle actieve verbindingen worden verbroken.'))return;const b=byId('reboot-now'),m=byId('reboot-message');b.disabled=true;b.textContent='Herstarten…';m.textContent='Herstartopdracht wordt verzonden…';try{const r=await fetch('/memo-network/system-info.cgi?action=reboot',{method:'POST',credentials:'same-origin',cache:'no-store',headers:{'X-Requested-With':'MemoNetwork'}});if(!r.ok)throw new Error('HTTP '+r.status);const j=await r.json();if(!j.ok)throw new Error(j.error||'Herstart mislukt');m.textContent='Server wordt nu herstart. Deze pagina zal tijdelijk niet bereikbaar zijn.';b.textContent='Herstart gestart'}catch(e){b.disabled=false;b.textContent='Nu herstarten';m.textContent='Herstart kon niet worden gestart: '+e.message}});
 async function refresh(){const started=performance.now();try{const r=await fetch('/memo-network/live-stats.cgi?v=4.4&_='+Date.now(),{credentials:'same-origin',cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);const d=await r.json();latest=d;failures=0;const cpu=num(d.cpu_percent),used=num(d.ram_used_gib),total=num(d.ram_total_gib),ramPct=total?used/total*100:0,rx=num(d.network_rx_kib_s),tx=num(d.network_tx_kib_s),load=num(d.load_1),cores=num(d.system&&d.system.cpu_cores)||1,loadPct=load/cores*100,disks=Array.isArray(d.disks)?d.disks:[],diskTotal=disks.reduce((a,x)=>a+num(x.total_gib),0),diskUsed=disks.reduce((a,x)=>a+num(x.used_gib),0),diskPct=diskTotal?diskUsed/diskTotal*100:0,alerts=Array.isArray(d.alerts)?d.alerts:[];byId('cpu').textContent=cpu.toFixed(1).replace('.0','')+'%';byId('cpu-bar').style.width=Math.min(100,cpu)+'%';byId('cpu-sub').textContent=cores+' cores · actuele belasting';severity(byId('cpu-card'),cpu,75,90);byId('ram').textContent=used.toFixed(2)+' GiB';byId('ram-total').textContent=total.toFixed(2)+' GiB totaal · '+ramPct.toFixed(1)+'%';byId('ram-bar').style.width=Math.min(100,ramPct)+'%';severity(byId('ram-card'),ramPct,75,90);byId('storage-used').textContent=size(diskUsed);byId('storage-sub').textContent=size(diskTotal)+' totaal · '+size(Math.max(0,diskTotal-diskUsed))+' vrij';byId('storage-bar').style.width=Math.min(100,diskPct)+'%';severity(byId('storage-card'),diskPct,75,90);byId('uptime').textContent=uptimeText(d.system&&d.system.uptime_seconds);byId('rx').textContent=rate(rx);byId('tx').textContent=rate(tx);byId('load1').textContent=load.toFixed(2);byId('load5').textContent='5 min: '+num(d.load_5).toFixed(2);byId('load15').textContent='15 min: '+num(d.load_15).toFixed(2);severity(byId('load-card'),loadPct,80,120);push(history.rx,rx);push(history.tx,tx);push(history.load,load);const maxNet=Math.max(...history.rx,...history.tx,1);chart('network-chart',[{data:history.rx,max:maxNet,cls:'rx'},{data:history.tx,max:maxNet,cls:'tx'}]);chart('load-chart',[{data:history.load,max:Math.max(...history.load,1),cls:'load'}]);const s=d.services||{};service('docker',s.docker);service('amp',s.amp);service('minio',s.minio);service('wireguard',s.wireguard);byId('docker-running').textContent=num(d.docker&&d.docker.running);byId('docker-total').textContent=num(d.docker&&d.docker.total);byId('amp-running').textContent=num(d.amp&&d.amp.running);byId('amp-total').textContent=num(d.amp&&d.amp.total);byId('minio-count').textContent=d.minio&&d.minio.mode==='docker'?`Docker · ${d.minio.container||'container'}`:d.minio&&d.minio.mode==='process'?'Lokaal proces':'S3-opslagservice';const wg=d.wireguard||{};byId('wireguard-count').textContent=`${num(wg.peers)} peer${num(wg.peers)===1?'':'s'} · ${wg.latest_handshake_age_seconds!=null?ageText(wg.latest_handshake_age_seconds):'geen handshake'}`;const updates=num(d.updates_available);byId('updates-title').textContent=updates+' pakketupdate'+(updates===1?'':'s')+' beschikbaar';byId('updates-alert').classList.toggle('show',updates>0);byId('reboot-alert').classList.toggle('show',!!d.reboot_required);byId('host-pill').textContent=(d.system&&d.system.hostname)||'Server';byId('sys-os').textContent=(d.system&&d.system.os)||'--';byId('sys-kernel').textContent=(d.system&&d.system.kernel)||'--';byId('sys-cpu').textContent=(d.system&&d.system.cpu)||'--';byId('sys-temp').textContent=d.system&&d.system.temperature_c!=null?d.system.temperature_c+'°C':'Niet beschikbaar';byId('sys-processes').textContent=num(d.system&&d.system.processes);byId('last-update').textContent=new Date().toLocaleTimeString('nl-NL',{hour:'2-digit',minute:'2-digit',second:'2-digit'});renderDisks(disks);renderIncidents(alerts);const latency=Math.round(performance.now()-started),pill=byId('api-pill');pill.textContent='LIVE · '+latency+' ms';pill.className='pill live';updateHealth({cpu,ramPct,diskPct,loadPct,services:s,latency,alerts});if(openService)renderServiceDetail(openService)}catch(e){failures++;const pill=byId('api-pill');pill.textContent=failures>2?'API OFFLINE':'VERBINDEN…';pill.className='pill error';byId('health-pill').textContent='Geen data';byId('health-pill').className='pill error'}}
 function schedule(){if(timer)clearInterval(timer);if(refreshMs>0)timer=setInterval(refresh,refreshMs);byId('refresh-label').textContent=refreshMs?`Automatisch: ${refreshMs/1000} sec`:'Automatisch: gepauzeerd'}
 byId('refresh-now').addEventListener('click',refresh);byId('refresh-select').value=String(refreshMs);byId('refresh-select').addEventListener('change',e=>{refreshMs=Number(e.target.value);localStorage.setItem('memoRefreshMs',String(refreshMs));schedule()});
 refresh();schedule();
})();
</script>
HTML
&popup_footer();
